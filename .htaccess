Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send any other hostname to the main site
  RewriteCond %{HTTP_HOST} !^illinivexu\.web\.illinois\.edu$ [NC]
  RewriteRule ^(.*)$ https://illinivexu.web.illinois.edu/$1 [R=301,L]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule . /index.html [L]
</IfModule>

# Correct types for modern assets
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

# Compress text responses (media is already compressed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Caching: Vite's /assets files have content hashes, so they can be cached forever.
# Media in /img and /videos keeps stable names, so cache for a week.
# index.html must always revalidate so new deploys show up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|mp4|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
